# duck — x86_64-linux desktop (NVIDIA, Wayland/umbriel, CUDA/OBS).
#
# Deliberately thin: this file wires the host's modules together and holds the
# one value that defines the install. Anything configuring a subsystem belongs
# in modules/<subsystem>.nix, not here.
{ ... }:
{
  imports = [
    # Generated by `nixos-generate-config`; do not hand-edit.
    ./hardware-configuration.nix

    ./modules
  ];

  # Release whose stateful defaults (paths, DB versions) this install was
  # created on. Never bump it on an existing system — see the option's docs.
  system.stateVersion = "25.11";
}
